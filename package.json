{
  "name": "ant-colony-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Ant Colony Sandbox: a pixel-art ecosystem simulator with cellular-automata terrain, autonomous ant colonies and heritable evolution.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node --experimental-strip-types --no-warnings scripts/bench.ts",
    "experiments": "node --experimental-strip-types --no-warnings scripts/experiments.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathewgeejo/ant-colony.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "22.15.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@fontsource/silkscreen": "5.2.8"
  }
}
